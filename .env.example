# Application Port & API
API_HOST=127.0.0.1
API_PORT=8000
VITE_API_URL=http://127.0.0.1:8000/api

# Database Configuration
# Option 1: Direct MySQL 8+ Connection (Uncomment and configure for MySQL)
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/paimana_db

# Option 2: Embedded SQLite Fallback (Default out-of-the-box local execution)
DATABASE_URL=

# Model Settings
MODEL_VERSION=heuristic-v1.0
ENABLE_PRECOMPUTED_CACHE=true
